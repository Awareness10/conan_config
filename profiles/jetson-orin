# Cross-compile for NVIDIA Jetson Orin (JetPack 6 / L4T R36: Ubuntu 22.04, glibc
# 2.35, GCC 11) from an x86_64 Linux machine. Use it as the host profile:
#
#   export JETSON_TOOLCHAIN=/opt/toolchains/aarch64-gcc11     # contains bin/
#   export JETSON_SYSROOT=/opt/l4t/rootfs                     # L4T rootfs or a copy of /usr + /lib
#   conan install . -pr:h jetson-orin --build=missing
#
# JETSON_CROSS_PREFIX is the tool name prefix (default aarch64-linux-gnu-). NVIDIA's
# Bootlin toolchain for JetPack 6 uses aarch64-buildroot-linux-gnu-.
#
# The sysroot provides glibc and the system libraries that aren't Conan packages
# (gst-plugins takes X11/EGL/GL from it). Without X11/GL dev files in the sysroot,
# add -o "gst-plugins/*:with_x11=False" (and with_gl=False).
{% set toolchain = os.getenv("JETSON_TOOLCHAIN", "/opt/toolchains/aarch64-gcc11") %}
{% set sysroot = os.getenv("JETSON_SYSROOT", "/opt/l4t/rootfs") %}
{% set prefix = toolchain + "/bin/" + os.getenv("JETSON_CROSS_PREFIX", "aarch64-linux-gnu-") %}
include(base)

[settings]
os=Linux
arch=armv8
compiler=gcc
compiler.version=11
compiler.libcxx=libstdc++11
compiler.cppstd=gnu17
build_type=Release

[buildenv]
CC={{ prefix }}gcc
CXX={{ prefix }}g++
AR={{ prefix }}ar
NM={{ prefix }}nm
RANLIB={{ prefix }}ranlib
STRIP={{ prefix }}strip
OBJCOPY={{ prefix }}objcopy

[conf]
tools.build:sysroot={{ sysroot }}
tools.build:compiler_executables={"c": "{{ prefix }}gcc", "cpp": "{{ prefix }}g++"}
# Ubuntu keeps libraries and some headers in multiarch folders (aarch64-linux-gnu).
# A Debian/Ubuntu cross GCC searches them; a generic toolchain (Bootlin, Arm GNU)
# doesn't. For one of those, uncomment:
# tools.build:cflags=["-isystem{{ sysroot }}/usr/include/aarch64-linux-gnu"]
# tools.build:cxxflags=["-isystem{{ sysroot }}/usr/include/aarch64-linux-gnu"]
# tools.build:sharedlinkflags=["-L{{ sysroot }}/usr/lib/aarch64-linux-gnu", "-L{{ sysroot }}/lib/aarch64-linux-gnu", "-B{{ sysroot }}/usr/lib/aarch64-linux-gnu", "-Wl,-rpath-link,{{ sysroot }}/usr/lib/aarch64-linux-gnu", "-Wl,-rpath-link,{{ sysroot }}/lib/aarch64-linux-gnu"]
# tools.build:exelinkflags=["-L{{ sysroot }}/usr/lib/aarch64-linux-gnu", "-L{{ sysroot }}/lib/aarch64-linux-gnu", "-B{{ sysroot }}/usr/lib/aarch64-linux-gnu", "-Wl,-rpath-link,{{ sysroot }}/usr/lib/aarch64-linux-gnu", "-Wl,-rpath-link,{{ sysroot }}/lib/aarch64-linux-gnu"]
